{
  "name": "openclaw-zenmux-provider",
  "version": "0.1.2",
  "description": "ZenMux LLM provider plugin for OpenClaw — OpenAI-compatible aggregator with 200+ models",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "llm",
    "zenmux",
    "ai",
    "provider"
  ],
  "homepage": "https://zenmux.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenmux/openclaw-zenmux-provider.git"
  },
  "bugs": {
    "url": "https://github.com/zenmux/openclaw-zenmux-provider/issues"
  },
  "files": [
    "dist/",
    "index.ts",
    "onboard.ts",
    "provider-catalog.ts",
    "zenmux-models.ts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "providers": [
      "zenmux"
    ],
    "compat": {
      "pluginApi": ">=2026.4.14",
      "minGatewayVersion": "2026.4.14"
    },
    "build": {
      "openclawVersion": "2026.4.14",
      "pluginSdkVersion": "2026.4.14"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "OPENCLAW_LIVE_TEST=1 vitest run --testNamePattern=live",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.14"
  },
  "devDependencies": {
    "openclaw": ">=2026.4.14",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
